---
import Logo from '../ui/Logo.astro';
import { site, socials } from '../../content/site';

const year = new Date().getFullYear();

const solutionsLinks = [
  { label: 'Production Routing Chart (PRC)', href: '/solutions/production-routing-chart' },
  { label: 'Warehouse Management (WMS)', href: '/solutions/warehouse-management-system' },
  { label: 'ERP for Manufacturers', href: '/solutions/erp-for-manufacturers' },
  { label: 'Logistics & Customs Software', href: '/solutions/logistics-software' },
];

const servicesLinks = [
  { label: 'SAP & System Integration', href: '/services/sap-and-system-integration' },
  { label: 'AI Automation for Plants', href: '/services/ai-automation-for-manufacturing' },
  { label: 'Custom Industrial Software', href: '/services/custom-software-for-factories' },
  { label: 'Composites & Fiber Moulding', href: '/industries/composites-and-fiber-moulding' },
];

const companyLinks = [
  { label: 'About Us', href: '/about' },
  { label: 'Case Studies', href: '/case-studies' },
  { label: 'Frequently Asked Questions', href: '/faq' },
  { label: 'Contact & Assessment', href: '/contact' },
  { label: 'AI Documentation (llms.txt)', href: '/llms.txt' },
];
---

<footer class="relative overflow-hidden bg-void">
  <!-- banked embers drifting faintly behind the buried wordmark -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <span class="ember-dot left-[18%] bottom-[10%]" style="--ember-opacity:0.4; --ember-drift:22px; animation-duration: 11s;"></span>
    <span class="ember-dot left-[52%] bottom-[6%]" style="--ember-opacity:0.3; --ember-drift:-16px; animation-duration: 13s; animation-delay: 3s;"></span>
    <span class="ember-dot left-[78%] bottom-[12%]" style="--ember-opacity:0.35; --ember-drift:12px; animation-duration: 9s; animation-delay: 6s;"></span>
  </div>

  <div class="wrap relative border-t border-hairline pt-14 pb-0">
    <div class="grid grid-cols-2 gap-x-8 gap-y-10 pb-14 md:grid-cols-4 lg:grid-cols-5">
      <!-- Col 1: Solutions -->
      <div>
        <h3 class="eyebrow mb-6">Solutions</h3>
        <ul class="space-y-3">
          {solutionsLinks.map((link) => (
            <li>
              <a href={link.href} class="text-xs sm:text-sm text-ivory/60 transition-colors hover:text-ember-amber">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 2: Services -->
      <div>
        <h3 class="eyebrow mb-6">Services</h3>
        <ul class="space-y-3">
          {servicesLinks.map((link) => (
            <li>
              <a href={link.href} class="text-xs sm:text-sm text-ivory/60 transition-colors hover:text-ember-amber">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Company -->
      <div>
        <h3 class="eyebrow mb-6">Company</h3>
        <ul class="space-y-3">
          {companyLinks.map((link) => (
            <li>
              <a href={link.href} class="text-xs sm:text-sm text-ivory/60 transition-colors hover:text-ember-amber">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Contact -->
      <div>
        <h3 class="eyebrow mb-6">Contact</h3>
        <ul class="space-y-3">
          <li>
            <a href={`mailto:${site.email}`} class="text-xs sm:text-sm text-ivory/60 transition-colors hover:text-ember-amber">
              {site.email}
            </a>
          </li>
          <li>
            <a href={site.phoneHref} class="text-xs sm:text-sm text-ivory/60 transition-colors hover:text-ember-amber">
              {site.phone}
            </a>
          </li>
          <li class="pt-2">
            <button type="button" class="consultation-trigger text-xs font-mono uppercase tracking-widest text-ember-core hover:text-ember-amber transition-colors cursor-pointer">
              Book Plant Assessment &rarr;
            </button>
          </li>
        </ul>
      </div>

      <!-- Col 5: Service Area & Status -->
      <div class="col-span-2 sm:col-span-1">
        <h3 class="eyebrow mb-6">Deployment</h3>
        <p class="font-mono text-[11px] leading-relaxed tracking-[0.14em] text-ivory/40 uppercase mb-4">
          Status: <span class="text-ember-amber/80">Operational</span><br />
          Service Area: <span class="text-ivory/70">{site.location}</span><br />
          Time: <span id="forge-clock"></span>
        </p>
        <ul class="flex gap-4">
          {socials.map((social) => (
            <li>
              <a href={social.href} rel="noopener noreferrer" target="_blank" class="text-xs font-mono uppercase text-ivory/50 transition-colors hover:text-ember-amber">
                {social.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="flex flex-col gap-2 border-t border-hairline py-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-ivory/30">
        &copy; {year} Ignis AI Labs. All rights reserved.
      </p>
      <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-ivory/30">
        Ready-Built Products &amp; Custom Plant Engineering &middot; India and Worldwide
      </p>
    </div>

    <!-- half-buried oversized wordmark — embers banked under ash -->
    <div class="pointer-events-none relative h-[16vw] max-h-56 overflow-hidden" aria-hidden="true">
      <Logo variant="wordmark" class="absolute left-1/2 top-4 w-[72vw] max-w-[1040px] -translate-x-1/2 text-ivory opacity-[0.05]" />
    </div>
  </div>
</footer>

<script>
  // live forge clock
  const clock = document.getElementById('forge-clock');
  function tick() {
    if (!clock) return;
    const time = new Date().toLocaleTimeString('en-IN', {
      timeZone: 'Asia/Kolkata',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    });
    clock.textContent = `${time} IST`;
  }
  tick();
  setInterval(tick, 30_000);
</script>
