---
import Logo from '../ui/Logo.astro';
import { site, navLinks, socials } from '../../content/site';

const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden bg-void">
  <!-- banked embers drifting faintly behind the buried wordmark -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <span class="ember-dot left-[18%] bottom-[10%]" style="--ember-opacity:0.4; --ember-drift:22px; animation-duration: 11s;"></span>
    <span class="ember-dot left-[52%] bottom-[6%]" style="--ember-opacity:0.3; --ember-drift:-16px; animation-duration: 13s; animation-delay: 3s;"></span>
    <span class="ember-dot left-[78%] bottom-[12%]" style="--ember-opacity:0.35; --ember-drift:12px; animation-duration: 9s; animation-delay: 6s;"></span>
  </div>

  <div class="wrap relative border-t border-hairline pt-14 pb-0">
    <div class="grid grid-cols-2 gap-x-8 gap-y-10 pb-14 md:grid-cols-4">
      <div>
        <h3 class="eyebrow mb-6">Sitemap</h3>
        <ul class="space-y-3">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-ivory/60 transition-colors hover:text-ember-amber">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="eyebrow mb-6">Contact</h3>
        <ul class="space-y-3">
          <li>
            <a href={`mailto:${site.email}`} class="text-sm text-ivory/60 transition-colors hover:text-ember-amber">{site.email}</a>
          </li>
          <li>
            <a href={site.phoneHref} class="text-sm text-ivory/60 transition-colors hover:text-ember-amber">{site.phone}</a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="eyebrow mb-6">Elsewhere</h3>
        <ul class="space-y-3">
          {socials.map((social) => (
            <li>
              <a href={social.href} rel="noopener noreferrer" target="_blank" class="text-sm text-ivory/60 transition-colors hover:text-ember-amber">{social.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="eyebrow mb-6">Status</h3>
        <p class="font-mono text-[11px] leading-relaxed tracking-[0.14em] text-ivory/40 uppercase">
          Forge status: <span class="text-ember-amber/80">Operational</span><br />
          {site.location} <span id="forge-clock"></span>
        </p>
      </div>
    </div>

    <div class="flex flex-col gap-2 border-t border-hairline py-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-ivory/30">
        © {year} Ignis AI Labs
      </p>
      <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-ivory/30">
        IGNIS — LATIN, “FIRE”
      </p>
    </div>

    <!-- half-buried oversized wordmark — embers banked under ash -->
    <div class="pointer-events-none relative h-[16vw] max-h-56 overflow-hidden" aria-hidden="true">
      <Logo variant="wordmark" class="absolute left-1/2 top-4 w-[72vw] max-w-[1040px] -translate-x-1/2 text-ivory opacity-[0.05]" />
    </div>
  </div>
</footer>

<script>
  // live forge clock — Chennai time
  const clock = document.getElementById('forge-clock');
  function tick() {
    if (!clock) return;
    const time = new Date().toLocaleTimeString('en-IN', {
      timeZone: 'Asia/Kolkata',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    });
    clock.textContent = `· ${time} IST`;
  }
  tick();
  setInterval(tick, 30_000);
</script>
