---
import { Image } from 'astro:assets';
import { trustedBy } from '../../content/testimonials';
---

<section class="overflow-hidden border-y border-hairline bg-void" aria-label="Trusted by">
  <!-- row 1: indexed logo cells, scrolling left -->
  <div class="marquee relative overflow-hidden" data-marquee>
    <span class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24 bg-gradient-to-r from-void to-transparent" aria-hidden="true"></span>
    <span class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24 bg-gradient-to-l from-void to-transparent" aria-hidden="true"></span>

    <div class="marquee-track items-stretch">
      {[0, 1].map((dup) => (
        <ul class="flex shrink-0 items-stretch" aria-hidden={dup === 1 ? 'true' : undefined}>
          {trustedBy.map((client, i) => (
            <li class="trusted-cell group flex shrink-0 items-center gap-5 border-r border-hairline px-10 py-6 transition-colors duration-300 hover:bg-surface-1">
              <span class="font-mono text-[10px] tracking-[0.18em] text-ember-amber/40 transition-colors duration-300 group-hover:text-ember-amber/80">
                {String(i + 1).padStart(2, '0')}
              </span>
              <Image
                src={client.logo}
                alt={dup === 0 ? client.name : ''}
                height={26}
                densities={[1, 2]}
                loading="lazy"
                decoding="async"
                class="h-[26px] w-auto opacity-45 brightness-0 invert-[0.93] sepia-[0.12] transition-opacity duration-300 group-hover:opacity-95"
              />
              <span class="whitespace-nowrap font-mono text-[10px] uppercase tracking-[0.18em] text-ivory/30 transition-colors duration-300 group-hover:text-ivory/70">
                {client.name}
              </span>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>

</section>
