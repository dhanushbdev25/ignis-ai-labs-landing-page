---
import Layout from '../layouts/Layout.astro';

export const prerender = true;
---

<Layout title="404 — Page Not Found | Ignis AI Labs" robots="noindex, nofollow">
  <section class="relative flex min-h-[100svh] flex-col items-center justify-center overflow-hidden bg-void text-center">
    <div class="heat-floor" aria-hidden="true"></div>

    <div class="wrap relative flex flex-col items-center py-32">
      <p class="eyebrow">404 / COLD TRACE — 0000°C</p>
      <h1 class="mt-8 max-w-3xl font-display text-display font-[340] text-ivory">
        This page never made it <em class="text-gradient-molten">out of the forge</em>.
      </h1>
      <p class="mt-6 max-w-md text-body-lg text-ivory/55">
        The address you followed doesn&rsquo;t exist — or has long since cooled.
      </p>
      <div class="mt-12 flex flex-wrap items-center justify-center gap-8">
        <a href="/" class="btn-molten">
          <span>Back to the fire</span>
          <svg viewBox="0 0 14 14" class="h-3 w-3" fill="none" aria-hidden="true">
            <path d="M1 7h11M8 2.5 12.5 7 8 11.5" stroke="currentColor" stroke-width="1.4" />
          </svg>
        </a>
        <button type="button" class="consultation-trigger link-filament">Contact us</button>
      </div>
    </div>
  </section>
</Layout>
