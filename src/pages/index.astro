---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import TrustedBy from '../components/sections/TrustedBy.astro';
import Applied from '../components/sections/Applied.astro';
import Translated from '../components/sections/Translated.astro';
import Forged from '../components/sections/Forged.astro';
import Deployed from '../components/sections/Deployed.astro';
import Trusted from '../components/sections/Trusted.astro';
import Faq from '../components/sections/Faq.astro';
import FinalCta from '../components/sections/FinalCta.astro';

export const prerender = true;
---

<Layout includeSoftwareSchemas={true} includeServiceSchemas={true}>
  <Hero />
  <TrustedBy />
  <Applied />
  <Translated />
  <Forged />
  <Deployed />
  <Trusted />
  <Faq />
  <FinalCta />
</Layout>
