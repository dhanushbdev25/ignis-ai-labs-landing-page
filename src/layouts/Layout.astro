---
import '../styles/global.css';
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';

import frauncesWoff2 from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import generalSans400 from '../assets/fonts/general-sans-400.woff2?url';
import generalSans500 from '../assets/fonts/general-sans-500.woff2?url';

import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Preloader from '../components/layout/Preloader.astro';
import ConsultationModal from '../components/islands/ConsultationModal';
import { site } from '../content/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;

const siteUrl = String(Astro.site || site.url);
const currentUrl = new URL(Astro.url.pathname, siteUrl).href;

const getAbsoluteUrl = (path: string) => {
  const baseUrl = siteUrl.endsWith('/') ? siteUrl.slice(0, -1) : siteUrl;
  return `${baseUrl}${path.startsWith('/') ? path : `/${path}`}`;
};

const ogImageUrl = getAbsoluteUrl('og-image.png');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <!-- SEO Meta Tags -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content="Ignis AI Labs" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="color-scheme" content="dark" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- Canonical URL -->
    <link rel="canonical" href={currentUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512x512.png" />

    <!-- Fonts — self-hosted, preload the above-the-fold faces -->
    <link rel="preload" as="font" type="font/woff2" crossorigin href={frauncesWoff2} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={generalSans400} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={generalSans500} />

    <!-- Page Title -->
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:site_name" content="Ignis AI Labs" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ignis AI Labs - Software development and engineering services. We build scalable, high-performance solutions that drive real business impact." />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="Ignis AI Labs - Software development and engineering services. We build scalable, high-performance solutions that drive real business impact." />

    <!-- Theme Color & Mobile -->
    <meta name="theme-color" content="#050403" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="mobile-web-app-capable" content="yes" />

    <!-- Ignition preloader gate: first visit per session + motion OK only.
         Inline so it runs before first paint — no flash either way. -->
    <script is:inline>
      try {
        if (
          !sessionStorage.getItem('ignis-ignited') &&
          matchMedia('(prefers-reduced-motion: no-preference)').matches
        ) {
          document.documentElement.classList.add('preloading');
        }
      } catch (e) {}
    </script>

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'Ignis AI Labs',
      url: siteUrl,
      logo: `${siteUrl}/images/systems/Ignis logo Dark Theme.svg`,
      description: description,
      email: site.email,
      telephone: site.phone,
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: site.phone,
        contactType: 'Customer Service',
        email: site.email,
        availableLanguage: ['English'],
      },
      sameAs: [],
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Ignis AI Labs',
      url: siteUrl,
      description: description,
    })} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[110] focus:bg-surface-2 focus:px-4 focus:py-2 focus:font-mono focus:text-xs focus:text-ivory"
    >
      Skip to content
    </a>
    <Preloader />
    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <!-- film grain over everything -->
    <div class="grain grain-overlay" aria-hidden="true"></div>

    <!-- heat cursor (populated + activated by the motion layer on desktop) -->
    <div id="heat-cursor" aria-hidden="true"></div>

    <ConsultationModal client:idle />

    <script>
      import '../lib/motion/index';
    </script>
  </body>
</html>
