---
import '../styles/global.css';
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';

import frauncesWoff2 from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';
import generalSans400 from '../assets/fonts/general-sans-400.woff2?url';
import generalSans500 from '../assets/fonts/general-sans-500.woff2?url';

import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Preloader from '../components/layout/Preloader.astro';
import ConsultationModal from '../components/islands/ConsultationModal';
import SEO from '../components/ui/SEO.astro';
import type { BreadcrumbItem, FaqItem } from '../lib/seo/schema';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  ogImageAlt?: string;
  breadcrumbs?: BreadcrumbItem[];
  faqs?: FaqItem[];
  includeSoftwareSchemas?: boolean;
  includeServiceSchemas?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  canonical,
  ogType,
  ogImage,
  ogImageAlt,
  breadcrumbs,
  faqs,
  includeSoftwareSchemas,
  includeServiceSchemas,
  publishedTime,
  modifiedTime,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <SEO
      title={title}
      description={description}
      canonical={canonical}
      ogType={ogType}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
      breadcrumbs={breadcrumbs}
      faqs={faqs}
      includeSoftwareSchemas={includeSoftwareSchemas}
      includeServiceSchemas={includeServiceSchemas}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />

    <!-- Fonts — self-hosted, preload the above-the-fold faces -->
    <link rel="preload" as="font" type="font/woff2" crossorigin href={frauncesWoff2} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={generalSans400} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href={generalSans500} />

    <!-- Ignition preloader gate: first visit per session + motion OK only.
         Inline so it runs before first paint — no flash either way. -->
    <script is:inline>
      try {
        if (
          !sessionStorage.getItem('ignis-ignited') &&
          matchMedia('(prefers-reduced-motion: no-preference)').matches
        ) {
          document.documentElement.classList.add('preloading');
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[110] focus:bg-surface-2 focus:px-4 focus:py-2 focus:font-mono focus:text-xs focus:text-ivory"
    >
      Skip to content
    </a>
    <Preloader />
    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <!-- film grain over everything -->
    <div class="grain grain-overlay" aria-hidden="true"></div>

    <!-- heat cursor (populated + activated by the motion layer on desktop) -->
    <div id="heat-cursor" aria-hidden="true"></div>

    <ConsultationModal client:idle />

    <script>
      import '../lib/motion/index';
    </script>
  </body>
</html>
