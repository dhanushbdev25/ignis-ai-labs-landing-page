{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "ignis-ai-labs-landing-page",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  }
}