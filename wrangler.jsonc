{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "ignis-ai-labs-landing-page",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "vars": {
    "CONTACT_EMAIL": "contact@ignisailabs.com",
    "RESEND_FROM_EMAIL": "noreply@ignisailabs.com"
  }
}
